# Copia este archivo como .env.local y pega tu API key de Google AI Studio:
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Modelo principal para analizar documentos y generar preguntas
GEMINI_MODEL=gemini-3.8-flash
# Modelos de respaldo (separados por comas) cuando el principal agota su cuota gratuita diaria
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite

# Modelo rápido para corregir respuestas escritas, y sus respaldos
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
GEMINI_FAST_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash

# auto: convierte Word/PowerPoint a PDF con el Office instalado (solo Windows)
# off: usa solo la extracción de texto e imágenes
OFFICE_PDF_CONVERSION=auto
